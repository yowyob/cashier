# Frontend caisse — déploiement Docker. Copier en .env et compléter.

# B2B strict : front → BFF caisse uniquement (jamais iwm en direct).
# Les deux cibles de routing pointent sur le même BFF ; le BFF relaie la gestion-tiers vers iwm.
ERP_CASHIER_BACKEND_URL=http://erp-cashier-backend:8081
GESTION_TIERS_BACKEND_URL=http://erp-cashier-backend:8081
ERP_TENANT_ID=11111111-1111-1111-1111-111111111111

# Secret de session Next (jose) : openssl rand -hex 32
AUTH_SECRET=change-me-strong-secret

USE_LOCAL_AUTH=false
TELEGRAM_BOT_TOKEN=

# Port public exposé sur la VM
FRONTEND_PUBLIC_PORT=3000

# Traefik : base d'hôte public (= <IP_VM>.nip.io)
PUBLIC_HOST=CHANGE_ME.nip.io
